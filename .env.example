# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# --- MQTT broker that receives decoded station data ---
MQTT_BROKER=localhost
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Remote ChirpStack / LoRaWAN broker (lora_receiver*.py) ---
REMOTE_MQTT_BROKER=
REMOTE_MQTT_USERNAME=
REMOTE_MQTT_PASSWORD=
LOCAL_MQTT_BROKER=localhost

# --- InfluxDB 2.x ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUXDB_PASSWORD=
GRAFANA_PASSWORD=
