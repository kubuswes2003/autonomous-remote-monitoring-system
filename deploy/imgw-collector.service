[Unit]
Description=IMGW Weather Data Collector → MQTT Bridge
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=oneshot
User=kuba
WorkingDirectory=/home/kuba/Autonomous-remote-monitoring-system-
ExecStart=/usr/bin/python3 /home/kuba/Autonomous-remote-monitoring-system-/imgw_meteo_collector_v2.py
StandardOutput=append:/var/log/imgw-collector.log
StandardError=append:/var/log/imgw-collector-error.log

# Restart on failure
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
